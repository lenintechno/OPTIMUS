# Application runtime
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# Supabase server configuration (required in Phase 2)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (required in Phase 4)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.5
GEMINI_TIMEOUT_SECONDS=15

# Optional speech-to-text fallback (stretch)
OPENAI_API_KEY=
